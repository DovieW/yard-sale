{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yard-sale-gold",
  "account_id": "93e4c35e8e074435f2cbcfc5c4a27916",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yard-sale-gold-db",
      "database_id": "bbcc32bb-a97e-427e-a69a-58641a7a386f",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "yard-sale-gold-thumbnails"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
